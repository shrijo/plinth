{
  "name": "plinth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @plinth/web dev",
    "build": "pnpm --filter @plinth/web build",
    "preview": "pnpm --filter @plinth/web preview",
    "desktop:dev": "pnpm --filter @plinth/desktop tauri dev",
    "desktop:build": "pnpm --filter @plinth/desktop tauri build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "oxlint": "^1.91.0",
    "typescript": "~7.0.2"
  }
}
