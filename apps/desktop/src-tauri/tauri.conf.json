{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Plinth",
  "version": "0.1.0",
  "identifier": "io.github.shrijo.plinth",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @plinth/web dev",
    "beforeBuildCommand": "pnpm --filter @plinth/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Plinth",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
